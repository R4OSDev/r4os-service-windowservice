R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=WINSVC
VERSION=0.1.36
LANGUAGE=Zig
SDK_PROFILE=r4os-zig-generation2
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/WINSVC.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query2:2
IMPORT=R4DRAW:Query2:2
IMPORT=R4DESK:Query2:2
IMPORT=R4DEV:Query2:2
ZIG_MODULE=desktop_diagnostics:Contract/desktop_diagnostics_v1.zig
META=service.name=WINSVC
META=service.args=/RUN
META=service.start=auto
META=service.enabled=yes
META=service.config=Injection\R4OS\CONFIG\SERVICES.R4S
ZIG_MODULE=desktop_check:../../Apps/Desktop/Contract/desktop_check_v2.zig
ZIG_MODULE=desktop_launch:Contract/desktop_launch_v1.zig
ZIG_MODULE=desktop_graphics:Contract/desktop_graphics_v1.zig
